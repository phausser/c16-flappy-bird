; TED (MOS 7360/8360) registers used by the initial PAL C16 build.

TED_CONTROL1 = $ff06
TED_CONTROL2 = $ff07
TED_SOUND_CTRL = $ff11
TED_MISC = $ff12
TED_CHAR_ADDR = $ff13
TED_VIDEO_ADDR = $ff14
TED_COLOR_BG = $ff15
TED_BORDER_COLOR = $ff19
TED_RASTER_LO = $ff1d

TED_CONTROL1_TEXT_25_ROWS = $18
TED_CONTROL2_TEXT_40_COLS = $88

TED_BLACK = $00
TED_GREEN = $05
TED_BLUE = $06
TED_LIGHT_BLUE = $0e
TED_YELLOW = $07

TED_LUMA_FULL = $70
TED_SKY_COLOR = TED_LUMA_FULL | TED_LIGHT_BLUE
TED_PIPE_COLOR = TED_LUMA_FULL | TED_GREEN
TED_GROUND_COLOR = TED_LUMA_FULL | TED_YELLOW
